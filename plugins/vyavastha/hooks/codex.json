{
  "description": "Vyavastha checks your requests against what your team has said and decided before Codex changes code, sums each session up for teammates under categories you control, answers your questions about the team, and lets you ask teammates’ agents, in each project where you switch it on. The first session on a computer that isn’t signed in opens the sign-in page.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VYAVASTHA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavastha.sh\" hook session-start",
            "timeout": 15,
            "statusMessage": "Connecting to Vyavastha"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VYAVASTHA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavastha.sh\" hook prompt",
            "timeout": 270,
            "statusMessage": "Checking against your team’s record"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "VYAVASTHA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavastha.sh\" hook edited",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "VYAVASTHA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavastha.sh\" hook stopped",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
