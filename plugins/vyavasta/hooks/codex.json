{
  "description": "Vyavasta checks your requests against what your team has said and decided before Codex changes code, sums each session up for teammates under categories you control, answers your questions about the team, and lets you ask teammates’ agents, in each project where you switch it on. The first session on a computer that isn’t signed in opens the sign-in page.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook session-start",
            "timeout": 15,
            "statusMessage": "Connecting to Vyavasta"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook prompt",
            "timeout": 270,
            "statusMessage": "Waiting for Vyavasta"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook before-run",
            "timeout": 100,
            "statusMessage": "Checking with Vyavasta"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook edited",
            "async": true,
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook edit-check",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "env VYAVASTA_TOOL=codex sh \"${PLUGIN_ROOT}/scripts/vyavasta.sh\" hook stopped",
            "timeout": 20,
            "statusMessage": "Sending your work to Vyavasta"
          }
        ]
      }
    ]
  }
}
