{
  "description": "Vyavasta checks your requests against what your team has said and decided before Claude changes code, sums each session up for teammates under categories you control, answers your questions about the team, and lets you ask teammates’ agents, in each project where you switch it on. The first session on a computer that isn’t signed in opens the sign-in page.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook session-start",
            "timeout": 15,
            "statusMessage": "Connecting to Vyavasta"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook wait",
            "async": true,
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook prompt",
            "timeout": 270,
            "statusMessage": "Waiting for Vyavasta"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "^vyavasta:",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook expansion",
            "timeout": 60,
            "statusMessage": "Waiting for Vyavasta"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook edited",
            "async": true
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook edit-check",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook stopped",
            "timeout": 20,
            "statusMessage": "Sending your work to Vyavasta"
          },
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook wait",
            "async": true,
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/vyavasta.sh\" hook stopped",
            "timeout": 20,
            "statusMessage": "Sending your work to Vyavasta"
          }
        ]
      }
    ]
  }
}
